{
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "npx prisma generate",
  "rewrites": [
    { "source": "/sistema/:path*", "destination": "/api" }
  ],
  "headers": [
    {
      "source": "/pos-v2/(dist|vendor)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/pos-v2/pos.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(favicon\\.(svg|png)|apple-touch-icon\\.png|logo\\.svg)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    },
    {
      "source": "/(index\\.html|pos-v2\\.html|)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  }
}
