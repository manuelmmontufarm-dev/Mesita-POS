{
  "name": "pos-mesita-demo",
  "version": "1.0.0",
  "description": "Demo POS system for MesitaQR + Contifico integration testing",
  "main": "desktop/main.cjs",
  "type": "commonjs",
  "scripts": {
    "start": "node scripts/start-production.js",
    "dev": "nodemon src/app.js",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node scripts/seed.js",
    "test": "jest --forceExit",
    "test:watch": "jest --watch",
    "build:pos-v2": "node scripts/build-pos-v2.js",
    "desktop": "electron .",
    "dist:desktop": "electron-builder --mac dir --arm64 --config desktop/builder.yml && cp -R node_modules/.prisma 'dist-desktop/mac-arm64/Contifico POS Lab.app/Contents/Resources/app/node_modules/'"
  },
  "keywords": [
    "pos",
    "restaurant",
    "mesitaqr",
    "contifico",
    "ecuador"
  ],
  "author": "jdonoso1",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "mysql2": "^3.23.1",
    "prisma": "^5.7.0",
    "qrcode": "^1.5.3",
    "serverless-http": "^3.2.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@types/jest": "^29.5.11",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  }
}