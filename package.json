{
  "name": "pos-mesita-demo",
  "version": "1.0.0",
  "description": "Demo POS system for MesitaQR + Contifico integration testing",
  "main": "src/app.js",
  "type": "commonjs",
  "scripts": {
    "start": "node scripts/start-production.js",
    "dev": "nodemon src/app.js",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node scripts/seed.js",
    "test": "node scripts/run-jest-isolated.js",
    "test:watch": "jest --watch",
    "build:pos-v2": "node scripts/build-pos-v2.js",
    "build:pos-pilot": "vite build --config client/pos-pilot/vite.config.ts",
    "dev:pos-pilot": "vite --config client/pos-pilot/vite.config.ts",
    "test:pos-pilot": "vitest run --config client/pos-pilot/vitest.config.ts",
    "test:e2e:pos-pilot": "playwright test --config client/pos-pilot/playwright.config.ts"
  },
  "keywords": [
    "pos",
    "restaurant",
    "mesitaqr",
    "contifico",
    "ecuador"
  ],
  "author": "jdonoso1",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "prisma": "^5.7.0",
    "qrcode": "^1.5.3",
    "serverless-http": "^3.2.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@playwright/test": "^1.55.0",
    "@types/jest": "^29.5.11",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.6.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "supertest": "^6.3.4",
    "typescript": "^5.8.3",
    "vite": "^6.1.0",
    "vitest": "^3.2.4"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
